#!/bin/sh
# Installed with: git config core.hooksPath tools/hooks  (once per
# clone).  See AGENTS.md.

# no game data: nothing below game/ or build/, no program or data files
if git diff --cached --name-only | grep -Eiq '^(game|build)/|\.(exe|com|sdr|mod|fli|vga|spr|ogg|gog|256|016|hop|bin)$'; then
    echo "pre-commit: game files staged:" >&2
    git diff --cached --name-only | grep -Ei '^(game|build)/|\.(exe|com|sdr|mod|fli|vga|spr|ogg|gog|256|016|hop|bin)$' >&2
    exit 1
fi

# the checks, when something they depend on changed (`python` on Windows,
# only `python3` on a Mac)
if git diff --cached --name-only | grep -Eq '^(src|tools|port/src/gen)/'; then
    if command -v python >/dev/null 2>&1; then
        exec python tools/check.py
    fi
    exec python3 tools/check.py
fi
exit 0
