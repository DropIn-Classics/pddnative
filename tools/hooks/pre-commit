#!/bin/sh
# Installed with: git config core.hooksPath tools/hooks  (once per clone;
# all worktrees share it).  See AGENTS.md.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
top=$(git rev-parse --show-toplevel)
main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)

# master is written from the main checkout only (merges after review)
if [ "$branch" = "master" ] && [ "$(cd "$top" && pwd)" != "$main" ]; then
    echo "pre-commit: no commits on master from a worktree ($top)" >&2
    exit 1
fi

# no game data: nothing below game/ or build/, no program or data files
if git diff --cached --name-only | grep -Eiq '^(game|build)/|\.(exe|com|sdr|mod|fli|vga|spr|ogg|gog|256|016|hop|bin)$'; then
    echo "pre-commit: game files staged:" >&2
    git diff --cached --name-only | grep -Ei '^(game|build)/|\.(exe|com|sdr|mod|fli|vga|spr|ogg|gog|256|016|hop|bin)$' >&2
    exit 1
fi

# the checks, when something they depend on changed
if git diff --cached --name-only | grep -Eq '^(src|tools|port/src/gen)/'; then
    exec python tools/check.py
fi
exit 0
