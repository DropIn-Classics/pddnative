; DDPCMAIN.EXE: the Deluxe menu (tables F1-F8, history F9, options F10)
; Hints for tools/disasm.py; numbers are hex.

exe DELUXE/DDPCMAIN.EXE

; the segments, from the relocations, the header (SS:SP = 0E41:0800) and
; FONTS holds menu/option glyph bitmaps, OPTIONS the option screen's data,
; strings and palettes, and HISTORY the history viewer's paths and data
segment CODE    0000 CODE
segment DATA    0448 DATA
segment FONTS   0766 FAR_DATA
segment OPTIONS 0B5E FAR_DATA
segment HISTORY 0BC2 FAR_DATA
segment STACK   0E41 STACK stack size=800

; the relocation table lists the sites in DATA first, then those in CODE
relocorder DATA CODE

; ---- code reached through pointers (comment says where each comes from)
; INT 9 handler set via AH=25h (MOV DX at CODE:1344, DS=CS)
ptr CODE:1344 CODE
; pointer variables DATA:31C7/31C5/31C9 holding code addresses, set to
; 0DD9/0DD2/04E5 at startup (MOVs at CODE:020F/0215/021B), to 0DE0 (a RET
; that disables them) at CODE:0C0C/0C12/0C18, and back at CODE:0E54/0E5A/0E60
ptr CODE:020F CODE
ptr CODE:0215 CODE
ptr CODE:021B CODE
ptr CODE:0C18 CODE
; sound callback for INT 66h AL=0Bh (far pointer ES:DX built at
; CODE:43D7-43DC via PUSH 4421 and PUSH CS/POP ES/POP DX; see INT 66h
; AL=0Bh at CODE:43E1 with ES:DX=CS:4421)
ptr CODE:43D7 CODE
; SOUND.CFG is data embedded in CODE, opened by load_sound at 434Ch
dptr CODE:434C CODE

; L3158 runs with DS=HISTORY (called from L3140 at CODE:314B with DS=HISTORY;
; CALL resets to DATA in the analysis, so override): its LEA DX,[0D19] /
; [0D0C] are HISTORY paths, and [1E26]/[1E28]/[1E2A] are HISTORY data
ds CODE:3158-31C8 HISTORY
; these callees inherit DS=HISTORY; calls reset the analysis to DATA
ds CODE:3234-3273 HISTORY
ds CODE:32DA-3347 HISTORY
ds CODE:3599-36A8 HISTORY
ds CODE:36A8-3713 HISTORY
ds CODE:3DBF-3DE1 HISTORY
ds CODE:3E09-3E3D HISTORY
ds CODE:3EE1-3F81 HISTORY
ds CODE:4394-43D2 HISTORY

; options_screen sets DS=OPTIONS; these callees inherit it (calls reset the
; analysis to DATA).  Routines which set DS themselves need no override.
ds CODE:1474-14A8 OPTIONS
ds CODE:159C-1611 OPTIONS
ds CODE:1681-186F OPTIONS
ds CODE:2BCA-2BEB OPTIONS
ds CODE:2F04-2F5C OPTIONS
ds CODE:2FD0-2FEA OPTIONS

; near-pointer tables in DATA read with BX in L0B59 (CHDIR/EXEC for tables)
words DATA:0D19 2 DATA
words DATA:0D1D 2 DATA

; HISTORY resource tables and the history menu's indirect CODE dispatch
words HISTORY:0D4A 5 HISTORY ; language directories
words HISTORY:0D8E 5 HISTORY ; .HOP files
words HISTORY:0DD2 5 HISTORY ; .IDX files
words HISTORY:0E0F 2 HISTORY ; intro module names, read by load_sound
words HISTORY:0EBE 0A HISTORY ; 10 manufacturer names
words HISTORY:10C7 1D HISTORY ; 29 designer names
words HISTORY:1174 16 HISTORY ; 22 year names
words HISTORY:1445 35 HISTORY ; 53 pinball-table names
words HISTORY:16CD 5 CODE ; history menu action dispatch at CODE:32DA/3302

; CMP r/m8,r8 (38h) where MASM writes 3Ah (like PD.hints raw entries)
raw CODE:05B1

; ---- dead code: each range decodes as complete routines ending RET/JMP,
; but no direct, immediate, table, INT-vector or mouse-callback reference to
; the cluster was found anywhere in the image (internal calls are noted)
code CODE:026B ; far-memory to planar VGA copy
code CODE:0BD4 ; alternative DOS memory resize via AH=4Ah
code CODE:0D1D ; grayscale DAC entry
code CODE:0D3E ; print the selected language name through DOS
code CODE:0D91 ; yes/no prompt; calls the dead DAC helper at 0EC1
code CODE:0DE1 ; one-shot intro/FLI/menu reinitializer
code CODE:0EC1 ; two bright DAC entries, called only by dead 0D91
code CODE:104A ; graphics-controller mode helper
code CODE:1056 ; companion graphics-controller routine
code CODE:1149 ; duplicate mode 13h initialization
code CODE:1414 ; clear the keyboard bitmap at DATA:1362
code CODE:3100 ; alternative DOS memory resize using CS-10h
code CODE:3273 ; orphan RET
code CODE:3274 ; VESA bank copy after the orphan RET
code CODE:1979 ; animated pixel copy using the offset tables at 19CA/22CA
code CODE:3904 ; unused history text helper
code CODE:4162 ; decimal number formatter
code CODE:418C ; pixel-copy helper after the formatter
code CODE:38F1 ; single mouse-reset call stub
code CODE:43D2 ; single jump to the sound-loader return

; ---- main routines and the interfaces they use
name CODE:0000 start
comment CODE:0000 initialize DOS memory, keyboard, intro, FLI and menu, then exit through DOS
name CODE:003E exit
comment CODE:003E stop sound, restore INT 9 and text mode, print a status message, DOS exit
name CODE:006B menu
comment CODE:006B initialize and run the animated table-selection menu
name CODE:0195 menu_init
name CODE:0240 check_memory
comment CODE:0240 resize the program and require at least 6630h paragraphs of free DOS memory
name CODE:02A4 poll_mouse
comment CODE:02A4 read mouse position and buttons with INT 33h when a mouse was found
name CODE:0642 load_hiscores
comment CODE:0642 load HISCORES.PD1 and HISCORES.PD2, using compiled defaults when absent
name CODE:0826 language_screen
comment CODE:0826 load raw 320x200 DDPCLANG.VGA through load_vga_image, show it with language_palette and return the selected language
name CODE:0B59 run_table
comment CODE:0B59 CHDIR to DREAMS1/2, EXEC PD.EXE/PD2.EXE with digit 0-3, then CHDIR back
name CODE:0BF0 run_selection
comment CODE:0BF0 dispatch F1-F8 to a table, F9 to history and F10 to options
name CODE:0C76 run_fli_player
comment CODE:0C76 EXEC DDFLIPLY.EXE with the selected digit in the DOS command tail
name CODE:0CD0 run_intro
comment CODE:0CD0 EXEC DDPCINTR.EXE with CD track digit 2 or 3 chosen from PIT channel 1 bit 0
name CODE:0E81 menu_video_init
comment CODE:0E81 load raw 320x790 SELECT.VGA through load_vga_image at Mode X offset 03C0h; menu_init shows it with select_palette
name CODE:0F0C set_mode_x
comment CODE:0F0C set mode 13h and unchain its VGA planes
name CODE:0F55 clear_palette
name CODE:0FA8 set_palette
name CODE:0FCD clear_vram
name CODE:101A wait_retrace
name CODE:1068 display_off
name CODE:1074 display_on
name CODE:11D1 read_file_far
comment CODE:11D1 read a file through DOS into consecutive 8000h-byte far-memory windows
name CODE:1205 write_file_far
comment CODE:1205 create and write a far-memory buffer through DOS
name CODE:128E load_vga_image
comment CODE:128E read a raw 320-pixel-wide indexed VGA image in at most 0FA00h-byte chunks and copy every fourth byte to one Mode X plane, advancing 3E80h plane bytes per chunk; SELECT.VGA is 320x790, the other callers' files 320x200
name CODE:12F0 copy_vga_image_planes
comment CODE:12F0 CX groups of four chunky pixels at DS:0000 to the four Mode X planes at ES:DI
name CODE:1329 install_keyboard
comment CODE:1329 save the old INT 9 vector and install keyboard_handler
name CODE:134E restore_keyboard
name CODE:1364 keyboard_handler
name CODE:142D options_screen
comment CODE:142D run the F10 options screen in OPTIONS until its exit flag is set
name CODE:16D3 options_init
comment CODE:16D3 initialize option graphics and mouse, load raw 320x200 DDPCBKGD.VGA and pointer-table DDPCICON.SPR, copy the background, set options_palette and load current options
name CODE:186F draw_options_cursor
comment CODE:186F draw DDPCICON.SPR record 0 (16x16) at the mouse position, treating colour 0 as transparent and saving the old background after the sprite file
name CODE:18EC restore_options_cursor
comment CODE:18EC restore the 16x16 background saved after DDPCICON.SPR
name CODE:2DC8 draw_option_icon
comment CODE:2DC8 draw DDPCICON.SPR record BX: its pointer-table record is width, height and indexed pixels; records 1-14 are 48x24 option icons (record 0 is the 16x16 cursor)
name CODE:30B8 copy_options_background
comment CODE:30B8 copy the 64000 raw indexed bytes of DDPCBKGD.VGA to mode 13h video memory
name CODE:2BEB load_options
comment CODE:2BEB read the 13-byte DDPCOPTN.BIN or install defaults, then copy it to options_buffer
name CODE:2CFE save_options
comment CODE:2CFE write the four choices, four key words and resolution byte to DDPCOPTN.BIN
name CODE:30D6 file_size
name CODE:3119 alloc_memory
name CODE:3126 free_memory
name CODE:3131 resize_memory
name CODE:3140 history_screen
comment CODE:3140 run the F9 History of Pinball viewer with DS and ES set to HISTORY
name CODE:3158 history_init
comment CODE:3158 CHDIR HISTORY, initialize Mode X with DDPCHIST.VGA, detect VESA 640x480x256, load HISTORY.FNT and the selected language's .IDX, choose the picture format and enter the viewer; the .HOP is loaded after leaving this menu
name CODE:31C8 history_loop
name CODE:33D3 load_history_font
comment CODE:33D3 allocate 800h bytes and read HISTORY.FNT: 256 glyphs, eight row bytes each; bit 7 is the glyph's left pixel
name CODE:33FF show_history_table
comment CODE:33FF choose the selected table record's first picture name; load .016 in VGA mode or .256 in VESA mode, then draw its indexed .HOP text
name CODE:344C browse_history_tables
name CODE:3508 draw_history_string
comment CODE:3508 draw a NUL-terminated string through HISTORY.FNT, one byte per 8-pixel glyph row, to all four VGA planes
name CODE:3599 filter_manufacturer
name CODE:35DC filter_designer
name CODE:361F filter_year
name CODE:3662 select_history_table
name CODE:36A4 leave_history_menu
name CODE:36A8 next_history_picture
comment CODE:36A8 cycle the selected table record's one or two picture-name offsets and load that .016 or .256 file
name CODE:3713 select_history_filter
name CODE:3963 select_history_picture_format
comment CODE:3963 when VESA mode 101h is available, change both picture names in every table record from .016 to .256 in place
name CODE:39AB load_history_picture_16
comment CODE:39AB read four 9600h-byte planes from the selected .016 file and copy them to VGA mode 12h: 640x480, one bit per plane and pixel
name CODE:3A0C copy_history_picture_plane
name CODE:3BDC filter_history_records
comment CODE:3599 HISTORY:16CD dispatches the manufacturer filter and rebuilds filtered_table_records
comment CODE:35DC HISTORY:16CD dispatches the designer filter and rebuilds filtered_table_records
comment CODE:361F HISTORY:16CD dispatches the year filter and rebuilds filtered_table_records
comment CODE:3662 HISTORY:16CD dispatches direct table selection
name CODE:3C61 load_history_picture_256
comment CODE:3C61 read the selected .256 file: 300h-byte VGA DAC palette then 640x480 pixel indices, copied through VESA 64K banks; the last 16 palette entries are replaced by history_palette_tail for the UI
name CODE:3D39 copy_history_picture_bank
name CODE:3DBF load_history_hop
comment CODE:3DBF load the selected language's whole .HOP file into hop_segment; its offsets and displayed-string counts come from the matching .IDX
name CODE:3E09 load_history_idx
comment CODE:3E09 read the selected language's 265-byte .IDX into history_text_index: 53 records of HOP start word, end-marker word (not used by the viewer), displayed-string-count-minus-one byte
name CODE:3E3D draw_history_record
comment CODE:3E3D use table record +0 as the .IDX record number, then draw count+1 NUL-terminated strings from the HOP start offset
name CODE:3EE1 draw_history_line
comment CODE:3EE1 draw one HOP string; in 16-colour mode skip all following NULs and add a row for each following 0Dh,0Ah, while VESA skips CR/LF within strings and following NULs so they add no row; the two-NUL loop at L3F53 is dead
name CODE:3F81 render_history_glyph
name CODE:41E5 load_sound
comment CODE:41E5 save drive/directory, load the SDR named by SOUND.CFG and register sound_callback
name CODE:4407 stop_sound
name CODE:4421 sound_callback
comment CODE:4421 INT 66h timer callback: call the three menu update pointers and release frame waits
name CODE:19CA pixel_video_offsets
name CODE:22CA pixel_source_offsets
comment CODE:19CA two 24-by-48 word offset tables used together by the dead pixel-copy routine at 1979
name CODE:421B sound_cfg_path

; ---- the menu's own routines (named for the port, read from the code)
name CODE:007B menu_loop
comment CODE:007B the list: 870h passes the first time, then the high score show; after the show 2D0h passes (the count of the fade_in before), after a table chosen in the show 3C0h: CX is set to 2D0h before show_menu_start there too, which leaves menu_start (3C0h) in CX, and no fade follows (checked in tools/run: both counts)
name CODE:00D5 hiscore_show_loop
comment CODE:00D5 the high score show: 5A0h passes, ended by a click (Enter) or F1-F10
name CODE:0193 menu_unused_word
comment CODE:0193 set to 1 by menu, read nowhere
name CODE:02D0 read_menu_keys
comment CODE:02D0 the keyboard as a mouse: CF when Esc is down (leave the menu); else the E0 arrows move the pointer 2 pixels (not above 0 on the left and the top), Enter clicks (mouse_buttons 1, then waits until no key is down), F1-F10 set selection 1-0Ah with mouse_buttons 2 and wait likewise; the pointer is given to the mouse driver (INT 33h AX=4), menu_key_seen set; only the first key found in this order counts
name CODE:0412 edge_scroll
comment CODE:0412 the pointer at the top (mouse_y <= 10h) scrolls the list up a row (menu_start - 50h) until menu_start is 3C0h, at the bottom (mouse_y >= 0A4h) down until 5780h; menu_row follows, kept in 0..118h
name CODE:045E select_at_pointer
comment CODE:045E a selection already made (F1-F10) is run; else the list row under the pointer (menu_row + mouse_y against the y ranges of menu_ranges) becomes the selection and is run
name CODE:049B draw_pointer
comment CODE:049B AX = a pointer record (pointer_table): mouse_x kept at most 130h, the record's x/y set to the pointer, the picture under it saved and the pointer drawn
name CODE:04CF remove_pointer
comment CODE:04CF AX = a pointer record: the picture saved under it put back
name CODE:04E5 ticker_step
comment CODE:04E5 each tick: the ticker line moves a pixel: every eighth pixel the next character is put into ticker_buffer (ticker_next_char), the column at ticker_x + 140h copied to ticker_x - 1 (for ticker_x 0 one byte before the buffer, the high byte of char_y), 80 bytes of each of 10 rows drawn to video memory from offset 50h, four pixels apart per plane; ticker_x runs 0..140h; nothing moves once ticker_state is 1
name CODE:0586 ticker_next_char
comment CODE:0586 the next character of the ticker text (ticker_ptr; a 0 starts the text again from ticker_text, '@' stops the ticker): its 8x10 glyph from FONTS (8 bytes a row, rows 140h apart) into ticker_buffer at ticker_x + 140h; a character not in char_set draws nothing
name CODE:05E7 hiscore_scroll
comment CODE:05E7 the high score show: menu_start moves by hiscore_scroll_step between 9240h and menu_start_end and rests 0D8h passes at each end
name CODE:063E hiscore_pause
name CODE:0640 hiscore_resting
name CODE:0691 draw_hiscores
comment CODE:0691 both HISCORES files drawn into the picture below the list: PD1's tables at hiscore_places_pd1, PD2's at hiscore_places_pd2, 3200h bytes (160 rows) further down
name CODE:06BF hiscore_program
comment CODE:06BF 0 while drawing PD1's high scores, 1 for PD2's
name CODE:06C1 draw_hiscore_tables
comment CODE:06C1 SI = four x/y word pairs, DI = 4 tables of 4 entries of 9 bytes (three initials, then the score as 6 BCD bytes: the first byte's low digit, then two digits a byte, 11 digits); an initial not in char_set draws nothing and the same byte is read again for the next one (DI does not move on); a row 0Bh lower each entry
name CODE:073C draw_hiscore_char
comment CODE:073C DX = the character's index in char_set: its glyph from FONTS:0C80 (index * 8; 10 rows 140h apart, two bytes a plane four apart, colour 0 transparent) at char_x/char_y of the picture (from menu offset 9240h + 3C0h, PD2's 3200h lower); char_x + 8. The plane loop starts with AX = the FONTS segment (just loaded into DS), not char_x: the glyph lands at char_x rounded down to 4 plus (FONTS AND 3), which depends on where DOS loaded the program (checked: under tools/run -loadfix FONTS is 177Eh, the first plane 2)
name CODE:07F7 char_index
comment CODE:07F7 BX = the index of DL in char_set (27h characters); DL = 0 when it is not there
name CODE:0903 detect_mouse
comment CODE:0903 INT 33h AX=0: mouse_present 1 when a driver answers FFFFh, else 0FEh
name CODE:0923 alloc_pointer_buffers
comment CODE:0923 for each pointer record: a DOS block of width * height / 16 paragraphs for the picture under it (+0Ch segment, +0Eh offset 0)
name CODE:095B draw_pointer_sprite
comment CODE:095B BX = pointer record: the picture under it saved (save_under_pointer), then its image (+8 segment, +0Ah offset, width x height, a byte a pixel in four plane runs) drawn at x/y + menu_start, the byte at +12h transparent
name CODE:0A2D sprite_x
name CODE:0A2F sprite_plane_wrap
name CODE:0A31 restore_under_pointer
comment CODE:0A31 BX = pointer record: the saved picture back at x/y + the start address it was saved at (+10h)
name CODE:0AE3 save_under_pointer
comment CODE:0AE3 the picture under the pointer (x/y + menu_start) copied to its buffer, menu_start kept at +10h
name CODE:0B55 sprite_w
name CODE:0B57 sprite_h
name CODE:0B58 sprite_key
name CODE:3DAE mouse_range
comment CODE:3DAE INT 33h AX=8 (y from BX to DX) and AX=7 (x from AX to CX)
name CODE:0BBE exec_ss
name CODE:0BC0 exec_sp
name CODE:12EE image_block
comment CODE:12EE the DOS block load_vga_image reads the picture into
name CODE:4341 sound_exec_ss
name CODE:4343 sound_exec_sp
name CODE:0DD2 tick_remove_pointer
name CODE:0DD9 tick_draw_pointer
name CODE:0DE0 tick_nothing
name CODE:0EE5 fade_out_screen
comment CODE:0EE5 the DAC read into palette_work and faded out from there, in place (each step scales the last step's values)
name CODE:0F6B set_split
comment CODE:0F6B CRTC line compare 178h: the screen's last 12 rows show video memory from offset 0 (the ticker)
name CODE:0FF5 set_planes
comment CODE:0FF5 DL = map mask, DH = read map
name CODE:100C wait_frames
name CODE:1080 fade_in
comment CODE:1080 ES:DI = CX bytes of DAC values: shown at 0/32 to 31/32 of them in 32 frames (the last step 31/32, not full)
name CODE:10D9 fade_out
comment CODE:10D9 ES:DI = CX bytes of DAC values: shown at 31/32 down to 0/32 of them in 32 frames, through palette_work
name CODE:1132 show_menu_start
comment CODE:1132 the CRTC start address from menu_start, then wait_retrace; CX is left holding menu_start
name CODE:11BB read_dac
comment CODE:11BB CX colours from AL on read from the DAC into ES:DI
name CODE:13C3 kbd_e0
name CODE:13C4 wait_keys_up
name CODE:13DF wait_key_down
name CODE:13FA any_key_down
comment CODE:13FA ZF clear when a key is down
name CODE:4403 saved_drive
name CODE:4405 module_index
name CODE:4474 in_callback
name CODE:4475 pointer_on
comment CODE:4475 sound_callback moves the pointer (tick_remove, tick_draw) only when this is not 0

name DATA:003A ticker_state
comment DATA:003A 1: the ticker stands (an '@' in the text); menu_init sets 0FEh
name DATA:003B ticker_x
name DATA:003D ticker_ptr
name DATA:003F ticker_text
name DATA:0043 pointer_0
comment DATA:0043 the pointer records, 13h bytes: x, y, width, height (byte), image segment and offset, save buffer segment and offset, the start address it was saved at, the transparent colour (+12h); 0 is the language screen's, 1 the menu's, 2 not used by the menu
name DATA:0056 pointer_1
name DATA:0069 pointer_2
name DATA:007C pointer_table
name DATA:0084 hiscores_pd1_default
name DATA:0114 hiscores_pd2_default
name DATA:01A8 exit_messages
name DATA:0C87 char_set
comment DATA:0C87 the characters of the ticker and high score fonts, in their order
name DATA:0D4C menu_ranges
comment DATA:0D4C the list's entries: a count (0Ah), then x1, y1, x2, y2 words each, y in the whole list (menu_row + the pointer's y)
name DATA:0D9D language_ranges
name DATA:0DC6 hiscore_places_pd1
name DATA:0DD6 hiscore_places_pd2
name DATA:134A menu_unused_byte
name DATA:134D menu_key_seen
name DATA:1350 menu_start
comment DATA:1350 the CRTC start address of the view into SELECT.VGA (3C0h the top of the list)
name DATA:1352 hiscore_scroll_step
name DATA:1354 menu_start_end
name DATA:135E menu_unused_word2
name DATA:1360 menu_row
comment DATA:1360 the list's row at the top of the view (0..118h)
name DATA:1362 key_map
comment DATA:1362 keyboard_handler's map: bit n = scancode n down, E0-prefixed keys + 80h
name DATA:1382 old_int9
name DATA:148E palette_work
name DATA:178E fade_level
name DATA:178F hiscores_pd1
name DATA:181F hiscores_pd2
name DATA:18AF char_x
name DATA:18B1 char_y
name DATA:18B3 ticker_buffer
comment DATA:18B3 10 rows of 280h bytes: the ticker line, twice over
name DATA:31B7 last_scancode
name DATA:31C5 tick_remove
name DATA:31C7 tick_draw
name DATA:31C9 tick_ticker
name FONTS:0000 ticker_font
name FONTS:0C80 hiscore_font
name CODE:4225 sound_driver_name
name CODE:4233 sound_exec_params
name CODE:4241 sound_exec_buffer

; ---- clear paths, buffers and state
name DATA:0CBB select_vga_path
name DATA:0CAE language_vga_path
name DATA:0CC6 hiscores_pd1_path
name DATA:0CDD hiscores_pd2_path
name DATA:0CF4 pd_program
name DATA:0CFB pd2_program
name DATA:0D03 dreams1_dir
name DATA:0D0E dreams2_dir
name DATA:0D19 table_programs
name DATA:0D1D table_dirs
name DATA:0D21 deluxe_dir
name DATA:0D32 fli_player_program
name DATA:0D3F intro_program
name DATA:1237 command_tail
comment DATA:1237 DOS command tail used by all three EXEC helpers
name DATA:133B exec_params
name DATA:134B language_index
comment DATA:134B history language 0..4: English, French, German, Italian, Spanish; selects the .HOP/.IDX pointer tables
name DATA:134C selection
comment DATA:134C menu selection: 1-8 tables, 9 history, 0Ah options
name DATA:1356 sound_loaded
name DATA:1357 frame_tick
name DATA:1358 mouse_present
name DATA:1359 mouse_x
name DATA:135B mouse_y
name DATA:135D mouse_buttons
name DATA:31B8 options_buffer
comment DATA:31B8 menu-side mirror of the current 13-byte DDPCOPTN.BIN options
name DATA:02F9 select_palette
comment DATA:02F9 300h-byte VGA DAC palette shown with SELECT.VGA
name DATA:05F9 language_palette
comment DATA:05F9 300h-byte VGA DAC palette shown with DDPCLANG.VGA
