; DDPCMAIN.EXE: the Deluxe menu (tables F1-F8, history F9, options F10)
; Hints for tools/disasm.py; numbers are hex.

exe DELUXE/DDPCMAIN.EXE

; the segments, from the relocations, the header (SS:SP = 0E41:0800) and
; the history viewer (HISTORY holds its paths like ..\history and data)
segment CODE    0000 CODE
segment DATA    0448 DATA
segment SEG1    0766 FAR_DATA
segment SEG2    0B5E FAR_DATA
segment HISTORY 0BC2 FAR_DATA
segment STACK   0E41 STACK stack size=800

; the relocation table lists the sites in DATA first, then those in CODE
relocorder DATA CODE

; ---- code reached through pointers (comment says where each comes from)
; INT 9 handler set via AH=25h (MOV DX at CODE:1344, DS=CS)
ptr CODE:1344 CODE
; pointer variables DATA:31C7/31C5/31C9 holding code addresses, set to
; 0DD9/0DD2/04E5 at startup (MOVs at CODE:020F/0215/021B), to 0DE0 (a RET
; that disables them) at CODE:0C0C/0C12/0C18, and back at CODE:0E54/0E5A/0E60
ptr CODE:020F CODE
ptr CODE:0215 CODE
ptr CODE:021B CODE
ptr CODE:0C18 CODE
; sound callback for INT 66h AL=0Bh (far pointer ES:DX built at
; CODE:43D7-43DC via PUSH 4421 and PUSH CS/POP ES/POP DX; see INT 66h
; AL=0Bh at CODE:43E1 with ES:DX=CS:4421)
ptr CODE:43D7 CODE

; L3158 runs with DS=SEG3 (called from L3140 at CODE:314B with DS=SEG3;
; CALL resets to DATA in the analysis, so override): its LEA DX,[0D19] /
; [0D0C] are SEG3 history paths, and [1E26]/[1E28]/[1E2A] are SEG3
ds CODE:3158-31C8 SEG3

; near-pointer tables in DATA read with BX in L0B59 (CHDIR/EXEC for tables)
words DATA:0D19 2 DATA
words DATA:0D1D 2 DATA

; CMP r/m8,r8 (38h) where MASM writes 3Ah (like PD.hints raw entries)
raw CODE:05B1

; ---- routine gaps decoded to find their pointers (PUSHA/PUSH starts with
; sensible bodies ending RET; entry pointer sought for each, dead code will
; be marked as such; all verified as code by linear decode, not data)
code CODE:026B ; routine, entry sought
code CODE:0BD4 ; shrinks memory via AH=4Ah, entry sought (before an EXEC?)
code CODE:0D1D ; palette via DAC ports, entry sought
code CODE:0DE1 ; tests [31CD]/[31CE], entry sought
code CODE:0EC1 ; routine, entry sought
code CODE:104A ; routine, entry sought
code CODE:1149 ; video mode 13h init, no refs found (dead duplicate?)
code CODE:1414 ; clears words at DATA:1362, entry sought
code CODE:3100 ; shrinks memory (MOV AX,CS/SUB AX,10h), entry sought
code CODE:3274 ; routine after orphan RET at 3273, entry sought
code CODE:3713 ; routine, entry sought
code CODE:3904 ; routine, entry sought
code CODE:3BDC ; sets DS=SEG3 itself (history), entry sought
code CODE:4162 ; routine, entry sought
code CODE:38F1 ; single CALL 13C4 stub, entry sought
code CODE:43D2 ; single JMP 43FF stub, entry sought
