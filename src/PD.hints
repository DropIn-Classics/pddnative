raw CODE:1B74
raw CODE:1D52
raw CODE:1FAE
raw CODE:2030
raw CODE:2374
raw CODE:253F
raw CODE:2662
; ADD SI,20H with a word immediate (a constant defined further down in
; the original source, most likely)
raw CODE:4441
raw CODE:4490
raw CODE:4511

