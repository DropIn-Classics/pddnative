; the sound routines run with DS = XDATA and ES = DATA (set by their
; callers, timer_callback and start_music; play_tune sets ES again)
ds CODE:5315-54EF XDATA
es CODE:5315-54EF DATA
; grey_palettes reads lights_off_pal through ES (checked: ES = DATA there,
; run with opt_palette 1)
es CODE:4DEF-4E1F DATA
; DS read from a register or the stack, DATA each time (checked by running:
; 45,000 passes of the sprite code, all with DS = DATA); write_file's only
; caller (save_hiscores) passes AX = DATA
ds CODE:475E-4762 DATA
ds CODE:476C-4770 DATA
ds CODE:48E2-48E6 DATA
ds CODE:27AE-27D5 DATA

; ---- encodings tasm.py does not choose by itself
; CMP r/m8,r8 (38h) where MASM writes 3Ah: the original has both
