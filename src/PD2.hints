; PD2.EXE: Pinball Dreams 2, Spidersoft's four tables (Neptune, Safari,
; Stall Turn and a fourth: REVENGE.FLI, files .MNG), Deluxe CD (= GOG).  The engine is
; PD.EXE's: most hints are carried over from PD.hints by tools/xfer.py.

exe DREAMS2/PD2.EXE

; the segments, from the relocations and the header (SS:SP = 1968:0200,
; the stack after BSS this time)
segment CODE  0000 CODE
segment TDATA 054B FAR_DATA
segment DATA  088F DATA
segment XDATA 123B XDATA
segment BSS   1279 BSS size=6EF0
segment STACK 1968 STACK stack size=200

relocorder DATA CODE

; ---- found for PD2 itself (the rest is carried over below)
words DATA:81BB 10 CODE     ; the main loop's routines per game state
code CODE:4B49              ; beep (PD CODE:4BD8)
code CODE:51B1              ; (PD CODE:5201)
; PD's CODE:27D5 (a row of INC AX) has no counterpart here
code CODE:2B62              ; (PD CODE:2B73, changed: clears words, not bytes)

; names xfer.py could not carry (the code around them differs, or two
; PD names meet at one address); what they are: see PD.hints
dptr CODE:0091 DATA         ; ADD BX,state_table
name CODE:0000 start
name CODE:0088 main_loop
name CODE:4EE8 st_quit
name CODE:0F9B fatal_error
name CODE:4D7C load_file
name CODE:279B write_file
name CODE:2B2C wait_keys_up
name CODE:0708 table_setup
name CODE:0780 setup_table0
comment CODE:0780 table 0: files .UND (presumably Neptune)
name CODE:08E4 setup_table1
comment CODE:08E4 table 1: .SFR (Safari)
name CODE:0A48 setup_table2
comment CODE:0A48 table 2: .MNG (the one REVENGE.FLI belongs to, presumably)
name CODE:0BB2 setup_table3
comment CODE:0BB2 table 3: .STT (Stall Turn)
name DATA:8261 flipper_x
comment DATA:8261 the flippers' x list, the same for all four tables
name CODE:108D setup_screen
name CODE:4B31 screen_off
name CODE:4B3D screen_on
name CODE:49FE set_palette
name CODE:4B49 beep
name CODE:4F00 load_sound_driver
name CODE:51B1 timer_callback

