dptr CODE:41F3 DATA ; add di, 0x89c7
; more of them, found while reading the engine (T4)
dptr CODE:0495 DATA ; mov [event_sp], event_stack
dptr CODE:049B DATA
dptr CODE:28B6 DATA
dptr CODE:28BC DATA
dptr CODE:3385 DATA ; cmp bx, event_stack
dptr CODE:1F21 DATA ; mov bx, lflipper_frame_to
dptr CODE:20E3 DATA ; mov bx, sine_table (a far pointer)
dptr CODE:2116 DATA ; mov bx, 9728h: the 24-bit value at 9727h, read from bx-1
dptr CODE:2281 DATA
