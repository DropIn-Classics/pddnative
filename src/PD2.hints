; word variables the per-table set-up fills with offsets (the analysis
; only sees a pointer variable when it is loaded and used as a base)
var DATA:84A9 DATA
var DATA:84AD DATA
var DATA:84AF DATA
var DATA:84B1 DATA
var DATA:84B3 DATA
var DATA:84B5 DATA
var DATA:84B7 DATA
var DATA:84B9 DATA
var DATA:84BB DATA
var DATA:84D3 DATA
var DATA:84DD DATA
var DATA:84DF DATA
