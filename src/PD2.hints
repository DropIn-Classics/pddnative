dptr CODE:1AB8 DATA ; add bx, 0x96f5
dptr CODE:1F43 DATA ; mov bx, 0x9746
dptr CODE:2030 DATA ; mov bx, 0x977e
dptr CODE:2037 DATA ; mov bx, 0x977f
dptr CODE:2059 DATA ; mov bx, 0x977e
dptr CODE:2060 DATA ; mov bx, 0x977f
dptr CODE:213A DATA ; mov bx, 0x9772
dptr CODE:2145 DATA ; mov bx, 0x9778
dptr CODE:2152 DATA ; mov bx, 0x9778
dptr CODE:215A DATA ; mov bx, 0x9772
dptr CODE:2242 DATA ; mov bx, 0x9772
dptr CODE:224D DATA ; mov bx, 0x9778
