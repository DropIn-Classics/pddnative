dptr CODE:226D DATA
dptr CODE:2130 DATA ; mov bx, 972Ch (nudge_push, the same way)
dptr CODE:2273 DATA
dptr CODE:4450 DATA ; cmp di, 7CFBh: fewer than two sprites in the list
